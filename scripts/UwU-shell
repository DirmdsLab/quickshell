
#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf 'Usage: %s {launcher|clipboard} [toggle|open|close|focus]\n' "$0" >&2
}

TARGET="${1:-}"

case "$TARGET" in
    launcher|clipboard)
        ;;
    *)
        usage
        exit 2
        ;;
esac

if [[ $# -gt 2 ]]; then
    usage
    exit 2
fi

ACTION="${2:-toggle}"

case "$ACTION" in
    toggle|open|close|focus)
        exec qs ipc call "$TARGET" "$ACTION"
        ;;
    *)
        usage
        exit 2
        ;;
esac
